{{- /* Netlify/Cloudflare-style _redirects, generated from data/oldlinks.yaml
       so the rules and the human-readable table cannot drift apart. */ -}}
# Generated by Hugo from data/oldlinks.yaml — do not edit by hand.
# Legacy paths from hexenworld.com and hexenworld.org.
{{ range hugo.Data.oldlinks -}}
{{- $slug := partial "legacy-slug.html" (dict "host" .host "from" .from) -}}
{{ printf "%-24s /moved/%s/ 301" .from $slug }}
{{ if hasSuffix .from "/" }}{{ printf "%-24s /moved/%s/ 301" (printf "%s*" .from) $slug }}
{{ end }}{{- end }}
# Everything else falls through to Hugo's own 404.
