{{- /* Apache equivalent of _redirects, same source data. Ship whichever the host wants. */ -}}
# Generated by Hugo from data/oldlinks.yaml — do not edit by hand.
<IfModule mod_rewrite.c>
RewriteEngine On
{{ range hugo.Data.oldlinks -}}
{{- $slug := partial "legacy-slug.html" (dict "host" .host "from" .from) -}}
{{- $bare := .from | strings.TrimPrefix "/" | strings.TrimSuffix "/" -}}
{{- $rx := replaceRE `\.` `\.` $bare -}}
{{ if hasSuffix .from "/" -}}
{{ printf "RewriteRule ^%s(/.*)?$ /moved/%s/ [R=301,L]" $rx $slug }}
{{ else -}}
{{ printf "RewriteRule ^%s$ /moved/%s/ [R=301,L]" $rx $slug }}
{{ end -}}
{{- end -}}
</IfModule>
